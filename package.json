{
  "name": "open-market-data",
  "version": "0.1.0",
  "description": "Unified CLI for free financial data APIs — SEC EDGAR, Yahoo Finance, Binance, CoinGecko, FRED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "omd": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:all": "vitest run && vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "finance",
    "stock",
    "crypto",
    "sec-edgar",
    "fred",
    "yahoo-finance",
    "binance",
    "coingecko",
    "cli",
    "market-data"
  ],
  "author": "anotb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anotb/open-market-data.git"
  },
  "homepage": "https://github.com/anotb/open-market-data",
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "yahoo-finance2": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
